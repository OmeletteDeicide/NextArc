rules_version = '2';

// Firebase Storage — seules les photos et bannières de profil sont stockées.
service firebase.storage {
  match /b/{bucket}/o {
    // avatars/{uid}.jpg : chacun ne lit et n'écrit que sa propre photo.
    // L'URL de téléchargement (avec jeton) reste lisible par l'app pour
    // l'afficher, y compris sur les cartes de partage.
    match /avatars/{fileName} {
      allow read: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // banners/{uid}.jpg : bannière envoyée depuis l'appareil, mêmes règles.
    match /banners/{fileName} {
      allow read: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Tout le reste est fermé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
